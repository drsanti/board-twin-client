{
  "name": "@ternion/board-twin-client",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the board-twin live-data broker (ws://127.0.0.1:7392)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
